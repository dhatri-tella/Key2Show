# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERVER_PORT: Optional Express server port. Defaults to 3000.
PORT=3000

# NODE_ENV: Use development or production.
NODE_ENV=development

# SESSION_SECRET: Optional server-side session/JWT signing secret.
# Use a random value of at least 16 characters in production.
SESSION_SECRET=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin access passcode.
# If unset, the Admin portal displays a one-time first-run setup form.
ADMIN_PASSCODE=

# TMDB_API_KEY: Optional TMDB API v3 key for live movie metadata sync.
# When unset, Key2Show runs cleanly in deterministic catalog sync mode.
TMDB_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Optional public browser key for interactive Google Maps venue explorer.
VITE_GOOGLE_MAPS_API_KEY=

# RESEND_API_KEY: Optional server-side API key for booking confirmation email delivery via Resend.
# When unset, Key2Show queues emails cleanly without failing transactions.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Optional verified sender used for booking confirmation email.
RESEND_FROM_EMAIL="Key2Show <bookings@resend.dev>"

# Razorpay test/live credentials. Never commit real credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional PostgreSQL/Drizzle configuration used by auxiliary database tooling.
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
